{
    "$schema": "https://raw.githubusercontent.com/ink0rr/rgl-schemas/main/config/v1.json",
    "author": "Your name",
    "name": "Lightweight TPS Counter",
    "packs": {
        "behaviorPack": "./packs/BP"
    },
    "regolith": {
        "dataPath": "./data",
        "filterDefinitions": {
			"esbuild": {
				"url": "github.com/ink0rr/regolith-filters",
				"version": "0.3.1"
			}
		},
        "profiles": {
            "default": {
                "export": {
                    "target": "development"
                },
                "filters": [
                    {
                        "filter": "esbuild"
                    }
                ]
            },
            "build": {
                "export": {
                    "target": "local"
                },
                "filters": [
                    {
                        "profile": "default"
                    }
                ]
            }
        }
    }
}
